    "geometry": {"state": "OPEN", "evidence": []},
    "device": {"state": "OPEN", "evidence": []}
  },
  "certification": {"state": "OPEN", "material_residue": ["Run exact-pin GUI/backend parity inventory and adjudicate all findings."]}
