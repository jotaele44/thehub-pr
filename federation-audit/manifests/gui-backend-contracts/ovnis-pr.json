{
  "schema_version": "federation.gui-backend-contract/1.0",
  "repository": "Jotaele44/ovnis-pr",
  "source_commit": "68b87366207cb3fe249814ee6611a03b18d67a6b",
  "policy": {"require_zero_material_residue": true, "dimensions": ["executability", "semantic", "state", "auth", "data", "provenance", "device", "identity", "geometry", "authority"]},
  "discovery": {
    "backend_roots": ["server/backend", "scripts"],
    "frontend_roots": ["dashboard/src"],
    "route_files": ["dashboard/src/App.jsx"],
    "navigation_files": ["dashboard/src/pages/Dashboard.jsx"],
    "existing_gui_capability_manifests": [".federation/gui-capabilities.json"]
  },
  "authority": {
    "semantic_authority": "uap-uso-observation-evidence-domain",
    "mutation_authority": "ovnis-domain-state-only",
    "identity_authority": "uap-uso-case-observation-source-identities",
    "geometry_authority": "consumer-of-spiderweb-for-federated-geometry",
    "provenance_authority": "uap-uso-source-and-case-evidence-provenance"
  },
  "auth": {"mutating_route_policy": "require_guard_or_explicit_public", "guard_patterns": ["Depends\\(", "require_admin", "require_write", "_WRITE_GUARD", "_require_key", "dependencies\\s*="], "explicit_public_mutations": []},
  "provenance": {"required_fields_when_available": ["source_ref", "source_hash", "evidence_tier", "review_status", "confidence"], "frontend_evidence_files": ["dashboard/src/App.jsx", "dashboard/src/pages/Dashboard.jsx"]},
  "devices": {"desktop": true, "mobile_web": true, "native_ios": false, "native_evidence_files": [], "intentional_restrictions": []},
  "backend_only_allowlist": [],
  "gui_only_allowlist": [],
  "state_claims": [],
  "runtime_evidence": {
    "data": {"state": "OPEN", "evidence": []},
    "identity": {"state": "OPEN", "evidence": []},
    "geometry": {"state": "OPEN", "evidence": []},
    "device": {"state": "OPEN", "evidence": []}
  },
  "certification": {"state": "OPEN", "material_residue": ["Prove case/observation evidence states cannot be visually promoted beyond backend truth."]}
}
