{
  "schema_version": "0.2.0",
  "probes": [
    {
      "probe_id": "thehub-desktop-boot",
      "repository": "thehub-pr",
      "surface_kind": "desktop",
      "entry_point": "desktop/launch.py",
      "cwd": ".",
      "command": ["python", "desktop/launch.py"],
      "mode": "boot",
      "startup_seconds": 5,
      "minimum_gate": "G3"
