{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/blob/main/federation-audit/contracts/gui-capabilities.schema.json",
  "title": "PRII GUI Capability Manifest",
  "description": "Shape of .federation/gui-capabilities.json. The semantic rules (paths exist, endpoints and routes are real, expiry dates) are enforced by scripts/check_gui_parity.py; see docs/FEDERATION_GUI_STANDARD.md.",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "discovery",
    "capabilities",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": "prii.gui-capability/v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "policy": {
      "type": "object",
      "description": "Informational restatement of the federation policy. The checker enforces the policy unconditionally and does not read this block."
    },
    "discovery": {
      "type": "object",
      "properties": {
        "backend_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "production_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "analysis_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frontend_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frontend_capability_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frontend_api_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "navigation_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Files that hold the visible navigation. Each must exist."
        },
        "e2e_config": {
          "description": "Playwright config(s) that collect the specs named in tests.e2e. When set, every tests.e2e file must be named in one of them.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "implicit_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "file"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            }
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "type": "object",
      "required": [
        "id",
        "classification",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "classification": {
          "enum": [
            "user",
            "operator",
            "analysis",
            "client_only",
            "internal"
          ]
        },
        "status": {
          "enum": [
            "active",
            "staged",
            "legacy"
          ]
        },
        "requires_terminal": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feature_flag": {
          "type": "string",
          "minLength": 1
        },
        "tracking": {
          "type": "string",
          "minLength": 1
        },
        "expires_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "backend": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "endpoints": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(GET|POST|PUT|PATCH|DELETE) /\\S*$"
              }
            },
            "symbols": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "analysis": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "symbols": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "frontend": {
          "type": "object",
          "properties": {
            "routes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "e2e_routes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "discoverability": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "tests": {
          "type": "object",
          "properties": {
            "contract": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "backend": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unit": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "e2e": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "staged"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "feature_flag",
              "tracking",
              "expires_on"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "internal"
              },
              "status": {
                "const": "active"
              }
            },
            "required": [
              "classification",
              "status"
            ]
          },
          "then": {
            "required": [
              "rationale"
            ]
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "required": [
        "id",
        "reason",
        "owner",
        "tracking",
        "expires_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "tracking": {
          "type": "string",
          "minLength": 1
        },
        "expires_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "candidate_ids"
          ],
          "properties": {
            "candidate_ids": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "candidate_files"
          ],
          "properties": {
            "candidate_files": {
              "minItems": 1
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
