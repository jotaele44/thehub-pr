{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/blob/main/federation-audit/experience-program/rc2/schemas/federation-navigation.schema.json",
  "title": "Federation navigation registry",
  "description": "The navigation of one application: static groups, plus optional pinned and recent groups whose contents are per-user settings. Applications keep their own layout; this fixes semantics, not appearance.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9-]+$": {}
  },
  "required": [
    "application",
    "addressing",
    "groups",
    "mobile"
  ],
  "properties": {
    "application": {
      "type": "string",
      "enum": [
        "aguayluz-pr",
        "centinelas-pr",
        "moneysweep-pr",
        "mucaro-ai",
        "ovnis-pr",
        "skywatcher-pr",
        "spiderweb-pr",
        "thehub-pr"
      ]
    },
    "addressing": {
      "type": "string",
      "enum": [
        "url-path",
        "url-query",
        "url-hash",
        "in-memory"
      ],
      "description": "in-memory means views cannot be deep-linked."
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x-[a-z0-9-]+$": {}
        },
        "required": [
          "id",
          "label",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "static",
              "pinned",
              "recent"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^x-[a-z0-9-]+$": {}
              },
              "required": [
                "id",
                "label",
                "target",
                "capability_id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "capability_id": {
                  "type": "string",
                  "minLength": 1
                },
                "keyboard_binding": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "object_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "overflow": {
            "type": "string",
            "enum": [
              "more-submenu",
              "scroll",
              "none"
            ]
          },
          "setting_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "static"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "items"
              ],
              "properties": {
                "items": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "description": "A pinned or recent group is bounded, says what overflows where, and names the setting that stores it.",
              "required": [
                "object_types",
                "max_items",
                "overflow",
                "setting_id"
              ],
              "not": {
                "required": [
                  "items"
                ]
              }
            }
          }
        ]
      }
    },
    "mobile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "toggle_accessible_name"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "enum": [
            "drawer",
            "bottom-bar",
            "tabs",
            "none"
          ]
        },
        "toggle_accessible_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "description": "A drawer is opened by a control with an accessible name.",
          "if": {
            "properties": {
              "pattern": {
                "const": "drawer"
              }
            },
            "required": [
              "pattern"
            ]
          },
          "then": {
            "properties": {
              "toggle_accessible_name": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
