{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/blob/main/federation-audit/experience-program/rc2/schemas/federation-compatibility.schema.json",
  "title": "Federation compatibility declaration",
  "description": "Which contract versions and shared packages one application works with. Every application must start on its own: there is no mandatory federation runtime.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9-]+$": {}
  },
  "required": [
    "application",
    "contract_version",
    "min_contract_version",
    "max_contract_version",
    "shared_packages",
    "desktop_runtime",
    "independent_startup",
    "federation_runtime_required"
  ],
  "properties": {
    "application": {
      "type": "string",
      "enum": [
        "aguayluz-pr",
        "centinelas-pr",
        "moneysweep-pr",
        "mucaro-ai",
        "ovnis-pr",
        "skywatcher-pr",
        "spiderweb-pr",
        "thehub-pr"
      ]
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "min_contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "max_contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "shared_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
          },
          "source": {
            "type": "string",
            "enum": [
              "registry",
              "file",
              "git",
              "archive"
            ]
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "desktop_runtime": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
            },
            "commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        }
      ]
    },
    "independent_startup": {
      "const": true
    },
    "federation_runtime_required": {
      "const": false
    },
    "known_incompatibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
