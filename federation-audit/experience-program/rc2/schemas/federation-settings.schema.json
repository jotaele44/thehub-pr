{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/blob/main/federation-audit/experience-program/rc2/schemas/federation-settings.schema.json",
  "title": "Federation setting definition",
  "description": "One setting or preference. Scope decides who owns the value and where it may live; an application-scoped setting can never be written into the federation-global namespace. Unknown fields are rejected except x-*.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9-]+$": {}
  },
  "required": [
    "id",
    "scope",
    "owning_application",
    "title",
    "value_type",
    "default",
    "storage",
    "applies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "GLOBAL_USER",
        "APPLICATION_USER",
        "WORKSPACE",
        "SESSION",
        "ADMINISTRATIVE",
        "SECRET"
      ]
    },
    "owning_application": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "aguayluz-pr",
            "centinelas-pr",
            "moneysweep-pr",
            "mucaro-ai",
            "ovnis-pr",
            "skywatcher-pr",
            "spiderweb-pr",
            "thehub-pr"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "value_type": {
      "type": "string",
      "enum": [
        "boolean",
        "string",
        "integer",
        "number",
        "enum",
        "path",
        "id-list"
      ]
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "default": {},
    "storage": {
      "type": "string",
      "enum": [
        "federation-profile",
        "app-local-storage",
        "app-session-storage",
        "app-backend",
        "os-keychain",
        "process-environment",
        "none"
      ]
    },
    "applies": {
      "type": "string",
      "enum": [
        "immediately",
        "next-launch"
      ]
    }
  },
  "allOf": [
    {
      "description": "Global values belong to the federation, not to one application.",
      "if": {
        "properties": {
          "scope": {
            "const": "GLOBAL_USER"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "owning_application": {
            "type": "null"
          },
          "id": {
            "pattern": "^federation\\."
          },
          "storage": {
            "const": "federation-profile"
          }
        }
      },
      "else": {
        "properties": {
          "owning_application": {
            "type": "string"
          },
          "id": {
            "not": {
              "pattern": "^federation\\."
            }
          },
          "storage": {
            "not": {
              "const": "federation-profile"
            }
          }
        }
      }
    },
    {
      "description": "A secret has no default and is never kept in plain browser or profile storage.",
      "if": {
        "properties": {
          "scope": {
            "const": "SECRET"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "default": {
            "type": "null"
          },
          "storage": {
            "enum": [
              "os-keychain",
              "process-environment",
              "app-session-storage"
            ]
          }
        }
      }
    },
    {
      "description": "A session value does not outlive the session.",
      "if": {
        "properties": {
          "scope": {
            "const": "SESSION"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "storage": {
            "enum": [
              "app-session-storage",
              "process-environment",
              "none"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "enum"
          }
        },
        "required": [
          "value_type"
        ]
      },
      "then": {
        "required": [
          "choices"
        ]
      }
    },
    {
      "description": "Lists such as pins and recents are bounded.",
      "if": {
        "properties": {
          "value_type": {
            "const": "id-list"
          }
        },
        "required": [
          "value_type"
        ]
      },
      "then": {
        "required": [
          "max_items"
        ]
      }
    }
  ]
}
