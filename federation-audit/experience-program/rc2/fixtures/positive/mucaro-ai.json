    "focus_visible": true
  },
  "accessibility": {
    "target": "WCAG 2.2 AA",
    "automated_scan": "OPEN",
    "manual_review": "BLOCKED",
    "known_failures": []
  },
  "evidence": {
    "provenance_fields": [
      "source_id",
      "source_hash",
      "retrieved_at"
