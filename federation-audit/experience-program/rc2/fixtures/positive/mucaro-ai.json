      "permission": "guest",
      "effect": "read",
      "availability": {
        "predicate": "conversation.not_pinned",
        "requires_online": false
      },
      "confirmation": "none",
      "audit_event": null,
      "keyboard_binding": null,
      "display_surfaces": [
        "item-menu",
        "context-menu"
