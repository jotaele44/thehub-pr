  "settings": [
    {
      "id": "federation.appearance.theme",
      "scope": "GLOBAL_USER",
      "owning_application": null,
      "title": "Theme",
      "value_type": "enum",
      "choices": [
        "system",
        "light",
        "dark"
      ],
      "default": "system",
      "storage": "federation-profile",
      "applies": "immediately"
    },
    {
      "id": "mucaro-ai.navigation.pins",
      "scope": "APPLICATION_USER",
      "owning_application": "mucaro-ai",
      "title": "Pinned conversations",
      "value_type": "id-list",
      "max_items": 10,
      "default": [],
      "storage": "app-local-storage",
      "applies": "immediately"
    },
    {
      "id": "mucaro-ai.navigation.recents",
      "scope": "APPLICATION_USER",
      "owning_application": "mucaro-ai",
      "title": "Recent conversations",
      "value_type": "id-list",
      "max_items": 20,
      "default": [],
      "storage": "app-local-storage",
      "applies": "immediately"
    },
    {
      "id": "mucaro-ai.model.api-key",
      "scope": "SECRET",
      "owning_application": "mucaro-ai",
      "title": "Model API key",
      "value_type": "string",
      "default": null,
      "storage": "process-environment",
      "applies": "next-launch"
    },
    {
      "id": "mucaro-ai.model.live-mode",
      "scope": "ADMINISTRATIVE",
      "owning_application": "mucaro-ai",
      "title": "Allow live model calls",
      "value_type": "boolean",
      "default": false,
      "storage": "process-environment",
      "applies": "next-launch"
    }
  ],
  "interaction": {
    "keyboard_complete": true,
    "touch_alternatives": true,
