#!/bin/bash
# Legacy source-checkout bundle: launch an embedded release runtime when
# present, or guide the user to the self-contained release using macOS UI only.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
BUNDLED="$HERE/PRII-THEHUB.bin"
RELEASES="https://github.com/jotaele44/thehub-pr/releases"
if [ -x "$BUNDLED" ]; then exec "$BUNDLED" --route /launcher; fi
CHOICE="$(osascript -e 'button returned of (display dialog "This source-checkout bundle does not contain the signed application runtime. Download the self-contained TheHub disk image; it includes everything required." buttons {"Cancel", "Open Releases"} default button "Open Releases" with title "TheHub")' 2>/dev/null || true)"
if [ "$CHOICE" = "Open Releases" ]; then open "$RELEASES"; fi
