{
  "@context": "../contexts/core.context.jsonld",
  "@id": "https://prii.dev/ontology/core",
  "@type": "prii:OntologyModule",
  "version": "0.1.0",
  "status": "proposed",
  "owner": "thehub-pr",
  "classes": [
    {"id": "prii:RepositoryNode", "label": "Repository Node", "owner": "thehub-pr"},
    {"id": "prii:ProducerRepository", "label": "Producer Repository", "subClassOf": "prii:RepositoryNode", "owner": "thehub-pr"},
    {"id": "prii:HubRepository", "label": "Hub Repository", "subClassOf": "prii:RepositoryNode", "owner": "thehub-pr"},
    {"id": "prii:Artifact", "label": "Artifact", "owner": "thehub-pr"},
    {"id": "prii:ExportPackage", "label": "Export Package", "subClassOf": "prii:Artifact", "owner": "thehub-pr"},
    {"id": "prii:CanonicalStream", "label": "Canonical Stream", "subClassOf": "prii:Artifact", "owner": "thehub-pr"},
    {"id": "prii:SourceRecord", "label": "Source Record", "owner": "thehub-pr"},
    {"id": "prii:MonitoredSource", "label": "Monitored Source", "owner": "producer"},
    {"id": "prii:SourceReference", "label": "Source Reference", "owner": "shared"},
    {"id": "prii:Entity", "label": "Entity", "owner": "shared"},
    {"id": "prii:EvidenceItem", "label": "Evidence Item", "owner": "shared"},
    {"id": "prii:ValidationEvidence", "label": "Validation Evidence", "owner": "thehub-pr"},
    {"id": "prii:LineageRecord", "label": "Lineage Record", "owner": "thehub-pr"},
    {"id": "prii:ConfidenceAssessment", "label": "Confidence Assessment", "owner": "shared"},
    {"id": "prii:RawObservation", "label": "Raw Observation", "owner": "producer"},
    {"id": "prii:CanonicalObservation", "label": "Canonical Observation", "owner": "thehub-pr"},
    {"id": "prii:AssertedRelationship", "label": "Asserted Relationship", "owner": "producer"},
    {"id": "prii:DerivedRelationship", "label": "Derived Relationship", "owner": "thehub-pr"},
    {"id": "prii:Correlation", "label": "Correlation", "subClassOf": "prii:DerivedRelationship", "owner": "thehub-pr"},
    {"id": "prii:AlertEvent", "label": "Alert Event", "owner": "producer"},
    {"id": "prii:CanonicalAlertRecord", "label": "Canonical Alert Record", "owner": "thehub-pr"},
    {"id": "prii:ValidationResult", "label": "Validation Result", "owner": "thehub-pr"},
    {"id": "prii:Attestation", "label": "Attestation", "owner": "thehub-pr"},
    {"id": "prii:ExecutionReceipt", "label": "Execution Receipt", "owner": "thehub-pr"},
    {"id": "prii:ReadinessGate", "label": "Readiness Gate", "owner": "thehub-pr"},
    {"id": "prii:LifecycleState", "label": "Lifecycle State", "owner": "shared"},
    {"id": "prii:PublicMatter", "label": "Public Matter", "owner": ["centinelas-pr", "moneysweep-pr"]}
  ],
  "properties": [
    {"id": "prii:ownedBy", "owner": "thehub-pr"},
    {"id": "prii:producedBy", "owner": "thehub-pr"},
    {"id": "prii:consumedBy", "owner": "thehub-pr"},
    {"id": "prii:assertedBy", "owner": "thehub-pr"},
    {"id": "prii:derivedBy", "owner": "thehub-pr"},
    {"id": "prii:hasSource", "owner": "thehub-pr"},
    {"id": "prii:hasEvidence", "owner": "thehub-pr"},
    {"id": "prii:hasLineage", "owner": "thehub-pr"},
    {"id": "prii:hasConfidenceAssessment", "owner": "thehub-pr"},
    {"id": "prii:hasLifecycleState", "owner": "thehub-pr"},
    {"id": "prii:value", "owner": "thehub-pr"},
    {"id": "prii:scale", "owner": "thehub-pr"},
    {"id": "prii:assessmentTarget", "owner": "thehub-pr"},
    {"id": "prii:method", "owner": "thehub-pr"},
    {"id": "prii:assessor", "owner": "thehub-pr"},
    {"id": "prii:createdAt", "owner": "thehub-pr"},
    {"id": "prii:extractedAt", "owner": "thehub-pr"},
    {"id": "prii:observedAt", "owner": "thehub-pr"},
    {"id": "prii:isSynthetic", "owner": "thehub-pr"},
    {"id": "prii:hasContentDigest", "owner": "thehub-pr"},
    {"id": "prii:conformsTo", "owner": "thehub-pr"},
    {"id": "prii:blocksExecution", "owner": "thehub-pr"}
  ]
