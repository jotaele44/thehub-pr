{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/schemas/cell_profile_v2.schema.json",
  "title": "PR Grid Geographic V2 Cell Profile",
  "description": "Additive V2 cell-profile envelope. V1 cell_profile@1 remains unchanged. Geometry never travels with a consumer profile; Spiderweb remains the sole geometry authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Contract_Version",
    "Grid_Identity",
    "Repository",
    "Profile_Type",
    "Data_State",
    "Record_Count",
    "Migration_State",
    "Summary",
    "Geometry_Included",
    "Deep_Link",
    "Identity_Default"
  ],
  "properties": {
    "Contract_Version": {"const": "pr-grid-v2-cell-profile/1.0"},
    "Grid_Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Grid_ID",
        "Grid_Version",
        "Grid_Level",
        "Cell_ID",
        "CRS",
        "Grid_Manifest_SHA256",
        "Cell_Schema_SHA256",
        "Binding_Schema_SHA256",
        "Mask_Schema_SHA256",
        "Geometry_Authority",
        "Authority_Commit"
      ],
      "properties": {
        "Grid_ID": {"const": "PR_GRID_GEOGRAPHIC_V2"},
        "Grid_Version": {"const": "2.0.0-rc1"},
        "Grid_Level": {"enum": ["L0", "L1", "L2", "L3"]},
        "Cell_ID": {"type": "string", "pattern": "^PRG2:L[0-3]:R[0-9]{3}:C[0-9]{4}$"},
        "CRS": {"const": "EPSG:6566"},
        "Grid_Manifest_SHA256": {"const": "8902af188ad449955119016f5747fe2393c582d9ed552fb03bcaecd9ab510aa4"},
        "Cell_Schema_SHA256": {"const": "1c173aee4b21b9baa545b656735155f2236a87c436d467a12132ef53b2592f5d"},
        "Binding_Schema_SHA256": {"const": "dabc461e47134b3b150be9aeb23b3d0097563493b33b3187538255e06b16a022"},
        "Mask_Schema_SHA256": {"const": "0b31b717d274b19686bf7f47edbabdaec31c86800f2ca7f1e73ffb663600978b"},
        "Geometry_Authority": {"const": "spiderweb-pr"},
        "Authority_Commit": {"const": "0c66e13d14232c0d7cbcbc179b3655904777dc71"}
      }
    },
    "Repository": {
      "enum": [
        "spiderweb-pr",
        "aguayluz-pr",
        "skywatcher-pr",
        "centinelas-pr",
        "moneysweep-pr",
        "ovnis-pr",
        "thehub-pr"
      ]
    },
    "Profile_Type": {"type": "string", "minLength": 1},
    "Data_State": {
      "enum": [
        "HAS_DATA",
        "ZERO_RECORDS",
        "NO_DATA",
        "NOT_APPLICABLE",
        "UNKNOWN",
        "STALE"
      ]
    },
    "Record_Count": {"type": ["integer", "null"], "minimum": 0},
    "Migration_State": {
      "enum": [
        "RECOMPUTED_FROM_SOURCE_GEOMETRY",
        "RECOMPUTED_FROM_SOURCE_COORDINATE",
        "VERIFIED_CROSSWALK",
        "PROVISIONAL_CROSSWALK",
        "AMBIGUOUS",
        "UNMIGRATED"
      ]
    },
    "Summary": {"type": "object"},
    "Categories": {"type": "array", "items": {"type": "object"}},
    "Top_Record_IDs": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 25
    },
    "Completeness": {"type": "object"},
    "Updated_At": {"type": ["string", "null"]},
    "Geometry_Included": {"const": false},
    "Deep_Link": {"type": "string", "pattern": "^/grid/PR_GRID_GEOGRAPHIC_V2/2\\.0\\.0-rc1/L[0-3]/PRG2:L[0-3]:R[0-9]{3}:C[0-9]{4}(\\?as_of=.+)?$"},
    "Identity_Default": {"const": "CANDIDATE_NOT_IDENTITY"}
  },
  "allOf": [
    {
      "if": {"properties": {"Data_State": {"const": "ZERO_RECORDS"}}, "required": ["Data_State"]},
      "then": {"properties": {"Record_Count": {"const": 0}}}
    },
    {
      "if": {"properties": {"Data_State": {"const": "HAS_DATA"}}, "required": ["Data_State"]},
      "then": {"properties": {"Record_Count": {"type": "integer", "minimum": 1}}}
    },
    {
      "if": {
        "properties": {
          "Data_State": {
            "enum": ["NO_DATA", "NOT_APPLICABLE", "UNKNOWN", "STALE"]
          }
        },
        "required": ["Data_State"]
      },
      "then": {"properties": {"Record_Count": {"type": "null"}}}
    },
    {
      "if": {"properties": {"Migration_State": {"const": "UNMIGRATED"}}, "required": ["Migration_State"]},
      "then": {
        "properties": {
          "Data_State": {"enum": ["UNKNOWN", "NOT_APPLICABLE"]},
          "Record_Count": {"type": "null"}
        }
      }
    }
  ]
}
