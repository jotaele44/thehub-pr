{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/schemas/cell_profile_v2.schema.json",
  "title": "PR Grid V2 Domain Cell Profile",
  "description": "Domain-owned profile; references Spiderweb-generated Cell_IDs, never carries canonical geometry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Schema_Version",
    "Grid_Identity",
    "Repository",
    "Profile_Type",
    "Cell_ID",
    "Data_State",
    "Coverage_State",
    "Record_Count",
    "Category_Count",
    "Categories",
    "Top_Record_IDs",
    "Shared_Boundary_Record_Count",
    "Identity_Default",
    "Geometry_Included",
    "Grid_Deep_Link",
    "Binding_Method_Counts",
    "Uncertainty_Class_Counts",
    "Exact_Record_Count",
    "Non_Exact_Record_Count",
    "Migration_Class"
  ],
  "properties": {
    "Schema_Version": {
      "const": "pr-grid-v2-cell-profile/1.2"
    },
    "Grid_Identity": {
      "type": "object",
      "required": [
        "Grid_ID",
        "Grid_Version",
        "Grid_Level",
        "CRS",
        "Grid_Manifest_SHA256",
        "Cell_ID",
        "Geometry_Authority",
        "Authority_Commit",
        "Cell_Schema_SHA256",
        "Binding_Schema_SHA256",
        "Mask_Schema_SHA256"
      ],
      "properties": {
        "Grid_ID": {
          "const": "PR_GRID_GEOGRAPHIC_V2"
        },
        "Grid_Version": {
          "const": "2.0.0-rc1"
        },
        "Grid_Level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ]
        },
        "CRS": {
          "const": "EPSG:6566"
        },
        "Grid_Manifest_SHA256": {
          "const": "8902af188ad449955119016f5747fe2393c582d9ed552fb03bcaecd9ab510aa4"
        },
        "Cell_ID": {
          "type": "string",
          "pattern": "^PRG2:L[0-3]:R[0-9]{3}:C[0-9]{4}$"
        },
        "Geometry_Authority": {
          "const": "spiderweb-pr"
        },
        "Authority_Commit": {
          "const": "0c66e13d14232c0d7cbcbc179b3655904777dc71"
        },
        "Cell_Schema_SHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "Binding_Schema_SHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "Mask_Schema_SHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "Repository": {
      "enum": [
        "aguayluz-pr",
        "skywatcher-pr",
        "ovnis-pr",
        "moneysweep-pr",
        "centinelas-pr"
      ]
    },
    "Profile_Type": {
      "enum": [
        "water_hydrology",
        "flight_activity",
        "anomalous_cases",
        "financial_activity",
        "monitoring_state"
      ]
    },
    "Cell_ID": {
      "type": "string",
      "pattern": "^PRG2:L[0-3]:R[0-9]{3}:C[0-9]{4}$"
    },
    "Data_State": {
      "enum": [
        "HAS_RECORDS",
        "ZERO_RECORDS",
        "NO_DATA"
      ]
    },
    "Coverage_State": {
      "enum": [
        "VERIFIED",
        "UNKNOWN"
      ]
    },
    "Record_Count": {
      "type": "integer",
      "minimum": 0
    },
    "Category_Count": {
      "type": "integer",
      "minimum": 0
    },
    "Categories": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "Top_Record_IDs": {
      "type": "array",
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "Shared_Boundary_Record_Count": {
      "type": "integer",
      "minimum": 0
    },
    "Identity_Default": {
      "const": "CANDIDATE_NOT_IDENTITY"
    },
    "Geometry_Included": {
      "const": false
    },
    "Grid_Deep_Link": {
      "type": "string",
      "pattern": "^/grid/PR_GRID_GEOGRAPHIC_V2/2\\.0\\.0-rc1/L[0-3]/PRG2:L[0-3]:R[0-9]{3}:C[0-9]{4}$"
    },
    "Binding_Method_Counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "Uncertainty_Class_Counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "Exact_Record_Count": {
      "type": "integer",
      "minimum": 0
    },
    "Non_Exact_Record_Count": {
      "type": "integer",
      "minimum": 0
    },
    "Migration_Class": {
      "enum": [
        "RECOMPUTED_FROM_SOURCE_COORDINATE",
        "RECOMPUTED_FROM_SOURCE_GEOMETRY",
        "VERIFIED_CROSSWALK"
      ]
    }
  }
}
