{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehub-pr/contracts/federation_provenance/v1",
  "x-contract-version": "1.0.0",
  "title": "Federation Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance_id","source_producer","local_record_id","evidence_id","payload_hash","created_at"],
  "properties": {
    "provenance_id": {"type":"string","pattern":"^fprov_[a-f0-9]{32}$"},
    "source_producer": {"type":"string","minLength":1},
    "local_record_id": {"type":"string","minLength":1},
    "evidence_id": {"type":"string","minLength":1},
    "payload_hash": {"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "created_at": {"type":"string","format":"date-time"}
  }
}
