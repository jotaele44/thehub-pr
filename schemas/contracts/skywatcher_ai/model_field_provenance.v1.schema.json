{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/schemas/contracts/skywatcher_ai/model_field_provenance.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "field_id", "source_artifact_id", "source_sha256", "model_run_receipt_id", "provider", "model", "model_revision", "prompt_template_version", "prompt_hash", "policy_version", "access_context_hash", "extraction_schema_version", "field_name", "value", "confidence", "validation_outcome", "review_status", "created_at"],
  "properties": {
    "schema_version": {"const": "model_field_provenance.v1"},
    "field_id": {"type": "string"},
    "source_artifact_id": {"type": "string"},
    "source_sha256": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/sha256"},
    "source_region": {"type": ["object", "null"]},
    "model_run_receipt_id": {"type": "string"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "model_revision": {"type": "string"},
    "prompt_template_version": {"type": "string"},
    "prompt_hash": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/sha256"},
    "policy_version": {"type": "string"},
    "access_context_hash": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/sha256"},
    "extraction_schema_version": {"type": "string"},
    "field_name": {"type": "string"},
    "value": {},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "validation_outcome": {"enum": ["VALID", "INVALID", "UNVERIFIED", "CONFLICTED"]},
    "review_status": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/review"},
    "reviewer_id": {"type": ["string", "null"]},
    "created_at": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/timestamp"},
    "supersedes_field_id": {"type": ["string", "null"]}
  }
}
