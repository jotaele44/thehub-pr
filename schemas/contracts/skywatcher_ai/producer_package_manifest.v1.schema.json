{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/schemas/contracts/skywatcher_ai/producer_package_manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_package_id",
    "package_sha256",
    "job_spec_id",
    "job_spec_sha256",
    "producer",
    "producer_revision",
    "worker_profile",
    "schema_revisions",
    "entries",
    "active_snapshot_promoted",
    "query_serving_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "producer_package_manifest.v1"
    },
    "producer_package_id": {
      "type": "string",
      "pattern": "^producer-package-sha256-[0-9a-f]{64}$"
    },
    "package_sha256": {
      "$ref": "skywatcher_ai_common.v1.schema.json#/$defs/sha256"
    },
    "job_spec_id": {
      "type": "string",
      "pattern": "^producer-job-sha256-[0-9a-f]{64}$"
    },
    "job_spec_sha256": {
      "$ref": "skywatcher_ai_common.v1.schema.json#/$defs/sha256"
    },
    "producer": {
      "const": "skywatcher-pr"
    },
    "producer_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "worker_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "version",
        "sha256"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "skywatcher_ai_common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "schema_revisions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output_id",
          "relative_path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "output_id": {
            "type": "string",
            "minLength": 1
          },
          "relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\\\\\)[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "$ref": "skywatcher_ai_common.v1.schema.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "active_snapshot_promoted": {
      "const": false
    },
    "query_serving_eligible": {
      "const": false
    }
  }
}
