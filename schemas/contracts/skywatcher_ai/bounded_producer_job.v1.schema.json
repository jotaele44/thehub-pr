{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/schemas/contracts/skywatcher_ai/bounded_producer_job.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "producer", "producer_revision", "operation_id", "signed_command_policy_id", "input_artifacts", "output_contract", "workspace_policy", "network_policy", "requested_by", "created_at"],
  "properties": {
    "schema_version": {"const": "bounded_producer_job.v1"},
    "job_id": {"type": "string"},
    "producer": {"const": "skywatcher-pr"},
    "producer_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operation_id": {"type": "string"},
    "signed_command_policy_id": {"type": "string"},
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "sha256", "read_only_locator"],
        "properties": {
          "artifact_id": {"type": "string"},
          "sha256": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/sha256"},
          "read_only_locator": {"type": "string"},
          "classification": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/classification"}
        }
      }
    },
    "output_contract": {
      "type": "object",
      "required": ["schema_id", "write_root"],
      "properties": {
        "schema_id": {"type": "string"},
        "write_root": {"type": "string"}
      }
    },
    "workspace_policy": {
      "type": "object",
      "required": ["ephemeral", "persistent_db_mounts", "evidence_db_access", "secret_readback"],
      "properties": {
        "ephemeral": {"const": true},
        "persistent_db_mounts": {"const": false},
        "evidence_db_access": {"const": false},
        "secret_readback": {"const": false}
      }
    },
    "network_policy": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": {"const": "DENY"},
        "approved_hosts": {"type": "array", "items": {"type": "string"}},
        "max_requests": {"type": "integer", "minimum": 0}
      }
    },
    "requested_by": {"type": "string"},
    "created_at": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/timestamp"}
  }
}
