{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/schemas/contracts/skywatcher_ai/legacy_artifact_disposition.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entry_id", "artifact_kind", "locator", "record_count", "classification", "disposition", "reason", "verified_at"],
  "properties": {
    "schema_version": {"const": "legacy_artifact_disposition.v1"},
    "entry_id": {"type": "string"},
    "artifact_kind": {"enum": ["SATELLITE_MANIFEST", "IMAGERY_CACHE", "VISION_CSV", "CHECKPOINT", "RLSM_MODEL_ROWS", "LOG", "OTHER"]},
    "locator": {"type": "string"},
    "sha256": {"oneOf": [{"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "record_count": {"type": "integer", "minimum": 0},
    "classification": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/classification"},
    "disposition": {"enum": ["MIGRATED_VERIFIED", "RETAINED_PRODUCER_LOCAL", "QUARANTINED", "SUPERSEDED", "DELETED_AFTER_VERIFICATION"]},
    "reason": {"type": "string"},
    "replacement_artifact_id": {"type": ["string", "null"]},
    "replacement_snapshot_id": {"type": ["string", "null"]},
    "verified_at": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/timestamp"}
  }
}
