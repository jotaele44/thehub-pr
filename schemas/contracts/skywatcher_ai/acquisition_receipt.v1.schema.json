{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jotaele44/thehub-pr/schemas/contracts/skywatcher_ai/acquisition_receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "operation_id", "provider", "requested_at", "completed_at", "outcome", "request_digest", "artifact_ids", "audit_event_id"],
  "properties": {
    "schema_version": {"const": "acquisition_receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "requested_at": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/timestamp"},
    "completed_at": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/timestamp"},
    "outcome": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/outcome"},
    "request_digest": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/sha256"},
    "artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "classification": {"$ref": "skywatcher_ai_common.v1.schema.json#/$defs/classification"},
    "egress_decision_id": {"type": ["string", "null"]},
    "failure": {"type": ["object", "null"]},
    "audit_event_id": {"type": "string", "minLength": 1}
  }
}
