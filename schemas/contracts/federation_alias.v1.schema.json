{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehub-pr/contracts/federation_alias/v1",
  "x-contract-version": "1.0.0",
  "title": "Federation Entity Alias",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "alias_id", "federation_entity_id", "alias_text", "normalized_alias", "provenance_id", "decision_id", "status", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "alias_id": {"type": "string", "pattern": "^falias_[a-f0-9]{32}$"},
    "federation_entity_id": {"type": "string", "pattern": "^fed_[a-f0-9]{32}$"},
    "alias_text": {"type": "string", "minLength": 1},
    "normalized_alias": {"type": "string", "minLength": 1},
    "provenance_id": {"type": "string", "pattern": "^fprov_[a-f0-9]{32}$"},
    "decision_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACTIVE", "SUPERSEDED", "TOMBSTONED"]},
    "superseded_by_alias_id": {"type": ["string", "null"], "pattern": "^falias_[a-f0-9]{32}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "x-unique-active": ["federation_entity_id", "normalized_alias"],
  "x-invariants": ["alias collisions never auto-merge federation entities", "aliases are audit-preserved"]
}
