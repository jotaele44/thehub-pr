{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prii.example/schemas/signed_command_policy.schema.json",
  "title": "PRII signed operations policy",
  "description": "Maps stable operation IDs to trusted executable identities and typed parameters. This artifact is separate from the declarative release catalog and is the only source of executable intent. It never carries a shell string: argv is assembled from an ordered list of literals and schema-validated parameters, so there is nothing for a shell to interpret.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "signature"],
  "properties": {
    "policy": { "$ref": "#/$defs/policy" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_id",
        "sequence",
        "minimum_accepted_sequence",
        "issued_at",
        "expires_at",
        "key_id",
        "operations",
        "security_invariants"
      ],
      "properties": {
        "schema_version": { "const": "prii_operations_policy_v1" },
        "policy_id": { "type": "string", "minLength": 1 },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonic anti-rollback counter. A verifier rejects any policy whose sequence is below the highest sequence it has already accepted."
        },
        "minimum_accepted_sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "Floor published by the issuer. A verifier rejects the policy when its own pinned floor is higher."
        },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "key_id": { "type": "string", "minLength": 1 },
        "security_invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },

    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "app_id",
        "repo",
        "category",
        "enablement",
        "target",
        "parameters",
        "argv",
        "risk_class",
        "approval_policy",
        "network_policy",
        "write_scope",
        "rollback_strategy",
        "promotion_state",
        "provenance"
      ],
      "properties": {
        "operation_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "app_id": { "type": "string", "enum": ["thehub", "ovnis", "centinelas", "skywatcher", "aguayluz", "spiderweb", "moneysweep"] },
        "repo": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "enablement": {
          "type": "string",
          "enum": ["ENABLED", "DECLARED_NOT_ENABLED"],
          "description": "Only ENABLED operations may be executed. DECLARED_NOT_ENABLED rows exist so every declared operation is accounted for with an explicit reason rather than silently dropped."
        },
        "enablement_reason": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameter" },
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "argv": {
          "type": "array",
          "description": "Ordered argv elements appended after the target's own executable and subcommand. Each element is either a fixed literal or a reference to a validated parameter; there is no interpolation, templating, or string splitting anywhere in the pipeline.",
          "items": { "$ref": "#/$defs/argv_element" }
        },
        "risk_class": {
          "type": "string",
          "enum": ["R0_READ_ONLY", "R1_DERIVED_WRITE", "R2_DATA_MUTATION", "R2_NETWORK_INGEST", "R3_LIFECYCLE"]
        },
        "approval_policy": { "type": "string", "minLength": 1 },
        "network_policy": { "type": "string", "minLength": 1 },
        "write_scope": { "type": "string", "minLength": 1 },
        "expected_outputs": { "type": "array", "items": { "type": "string" } },
        "local_input_refs": { "type": "array", "items": { "type": "string" } },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "secret_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "description": "Secret identifiers only. A secret value never appears in this document."
        },
        "rollback_strategy": { "type": "string", "minLength": 1 },
        "promotion_state": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "declared_source_text": {
              "type": "string",
              "description": "The original shell string this operation was derived from, retained for audit only. It is never parsed, split, or executed; the argv builder has no access to it."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enablement": { "const": "ENABLED" } },
            "required": ["enablement"]
          },
          "then": {
            "properties": {
              "target": {
                "properties": { "kind": { "not": { "const": "composite_unresolved" } } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "enablement": { "const": "DECLARED_NOT_ENABLED" } },
            "required": ["enablement"]
          },
          "then": { "required": ["enablement_reason"] }
        }
      ]
    },

    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "internal_builtin",
            "console_script",
            "python_module",
            "python_script",
            "make_target",
            "composite_unresolved"
          ],
          "description": "'composite_unresolved' records a declaration that is still a shell composite and has not been decomposed into a trusted executable identity. It is non-executable by construction and may appear only on a DECLARED_NOT_ENABLED operation."
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "description": "console_script: an installed script name resolved on PATH by basename. python_module: a module name for -m. python_script: a path relative to the pinned app root. make_target: an allow-listed target name. internal_builtin: a manager-internal handler name.",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\-/]*$"
        },
        "subcommand": {
          "type": "string",
          "description": "A fixed subcommand emitted immediately after the executable.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$"
        }
      }
    },

    "argv_element": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "literal": { "type": "string" },
        "param": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },

    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "fixed",
            "string",
            "integer",
            "number",
            "boolean",
            "enum",
            "datetime",
            "directory",
            "managed_output_directory",
            "managed_file",
            "managed_sqlite_path",
            "file_token",
            "file_set_token"
          ]
        },
        "required": { "type": "boolean", "default": false },
        "value": { "description": "Only meaningful for type 'fixed'." },
        "default": {},
        "values": { "type": "array", "items": { "type": "string" }, "description": "Permitted values for type 'enum'." },
        "extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" } },
        "family": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "max_length": { "type": "integer", "minimum": 1 },
        "pattern": { "type": "string" },
        "omit_when_false": {
          "type": "boolean",
          "default": true,
          "description": "For boolean flags: emit the preceding literal only when the value is true."
        }
      }
    },

    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "value", "payload_sha256"],
      "properties": {
        "key_id": { "type": "string", "minLength": 1 },
        "algorithm": { "const": "Ed25519" },
        "value": { "type": "string", "description": "Base64 Ed25519 signature over the canonical JSON encoding of `policy`." },
        "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
