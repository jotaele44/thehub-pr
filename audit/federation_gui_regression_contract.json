{
  "schema_version": "1.0",
  "scope": "PRII federation GUI certification",
  "rule": "A fixture is PASS only when the rendered state is semantically correct, accessible, non-misleading, and does not silently collapse into a normal success state.",
  "positive_fixtures": [
    {"id":"POS_NONEMPTY","input":"valid representative non-empty dataset","expected":"SUCCESS_NONEMPTY"},
    {"id":"POS_EMPTY","input":"successful authoritative empty dataset","expected":"SUCCESS_EMPTY"},
    {"id":"POS_FILTERED_ZERO","input":"non-empty dataset plus filter excluding all rows","expected":"FILTERED_TO_ZERO"},
    {"id":"POS_FACT","input":"authoritative factual observation","expected":"FACT"},
    {"id":"POS_COMPUTED","input":"deterministically derived value","expected":"COMPUTED"},
    {"id":"POS_BINDING","input":"authoritative identity binding","expected":"BINDING"},
    {"id":"POS_UNRESOLVED","input":"tied or insufficient identity evidence","expected":"UNRESOLVED"},
    {"id":"POS_SUPERSEDED","input":"adjudicated displaced observation","expected":"SUPERSEDED"}
  ],
  "negative_fixtures": [
    {"id":"NEG_NULL","input":"null field/value","must_not":"invent value or coerce to zero"},
    {"id":"NEG_UNDEFINED","input":"missing optional property","must_not":"crash or imply authoritative absence"},
    {"id":"NEG_EMPTY_STRING","input":"empty raw string","must_not":"silently canonicalize into a substantive value"},
    {"id":"NEG_DUPLICATE_ID","input":"duplicate stable identifier","must_not":"silently merge records"},
    {"id":"NEG_DUPLICATE_NAME","input":"same normalized name on distinct records","must_not":"prove identity from name equality"},
    {"id":"NEG_LONG_NAME","input":"200+ character legal/entity name","must_not":"clip inaccessible identity-critical text"},
    {"id":"NEG_UNICODE","input":"Spanish accents, smart punctuation, mojibake/raw defects","must_not":"overwrite RAW representation"},
    {"id":"NEG_LARGE_CURRENCY","input":"very large monetary amount","must_not":"overflow, truncate material digits, or lose sign"},
    {"id":"NEG_NEGATIVE_CURRENCY","input":"negative monetary transaction","must_not":"render as positive flow"},
    {"id":"NEG_INVALID_DATE","input":"malformed or impossible date","must_not":"silently substitute current date"},
    {"id":"NEG_STALE","input":"valid but stale source timestamp","expected":"STALE_RESULT"},
    {"id":"NEG_PARTIAL","input":"partial producer response","expected":"PARTIAL_RESULT"},
    {"id":"NEG_OFFLINE","input":"producer unavailable","expected":"PRODUCER_OFFLINE"},
    {"id":"NEG_TIMEOUT","input":"request timeout","expected":"TIMEOUT"},
    {"id":"NEG_429","input":"rate limited upstream","expected":"RATE_LIMITED"},
    {"id":"NEG_500","input":"server error","expected":"QUERY_FAILED"},
    {"id":"NEG_MALFORMED_SCHEMA","input":"HTTP success with schema-invalid rows","must_not":"drop invalid rows and present a normal empty success without degradation notice"},
    {"id":"NEG_AMBIGUOUS_IDENTITY","input":"two candidates tied at top evidence","expected":"UNRESOLVED"},
    {"id":"NEG_1_TO_N","input":"one source entity maps to multiple candidates","must_not":"collapse to 1:1 without evidence"},
    {"id":"NEG_N_TO_1","input":"multiple source entities map to one candidate","must_not":"merge without explicit adjudication"},
    {"id":"NEG_N_TO_N","input":"many-to-many relationship candidates","must_not":"synthesize a single canonical row"},
    {"id":"NEG_CONTRADICTION","input":"two authoritative observations conflict","expected":"CONTRADICTION"},
    {"id":"NEG_SOURCE_MISSING","input":"source/provenance absent","must_not":"show VERIFIED provenance"},
    {"id":"NEG_HASH_MISMATCH","input":"payload hash mismatch","must_not":"show normal verified success"}
  ],
  "required_viewports": [320,375,768,1280,1440,1920],
  "required_browser_engines": ["chromium","firefox","webkit"],
  "required_accessibility_modes": ["keyboard-only","200%-zoom","reduced-motion"],
  "certification": "OPEN"
}
